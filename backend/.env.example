# ---- Flask ----
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
APP_DEBUG=True

# ---- Database (MySQL via PyMySQL) ----
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_tech_hub

# ---- JWT ----
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Rate limiting ----
RATELIMIT_STORAGE_URL=redis://localhost:6379/1

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# ---- AI Provider ----
# Active provider is "gemini" when GEMINI_API_KEY is set, else local "ollama".
DEFAULT_AI_PROVIDER=gemini

# ---- Gemini (cloud) ----
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=15000
# Failover chain used when the primary model is rate-limited (free-tier quota is
# metered PER MODEL, so switching models keeps real AI answers flowing).
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash,gemini-flash-latest
# Identical prompts are cached for this long (ms) to save quota.
GEMINI_CACHE_TTL_MS=300000
AI_MODEL=gemini-2.5-flash-lite

# ---- Ollama (local fallback / image synthesis with llava) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_CHAT_MODEL=llama3.1
OLLAMA_DEFAULT_CODE_MODEL=qwen2.5-coder
OLLAMA_DEFAULT_IMAGE_MODEL=llava

# ---- Uploads ----
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=26214400
ALLOWED_EXTENSIONS=txt,md,pdf,docx,png,jpg,jpeg,gif,webp
