# ---- Flask Development Configuration ----
FLASK_ENV=development
SECRET_KEY=antigravity-dev-secret-super-key-at-least-32-chars-long!
APP_DEBUG=True

# ---- Database ----
# By default uses local SQLite for instant zero-config startup; point to MySQL in production:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_techhub
DATABASE_URL=sqlite:///ai_techhub.db

# ---- JWT Authentication ----
JWT_SECRET_KEY=antigravity-dev-jwt-super-secret-key-at-least-32-chars!
JWT_ACCESS_TOKEN_EXPIRES=86400
JWT_REFRESH_TOKEN_EXPIRES=2592000

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ---- Rate Limiting (in-memory for standalone dev) ----
RATELIMIT_STORAGE_URL=memory://

# ---- Celery / Redis ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# ---- AI Provider ----
# Active provider is "gemini" when GEMINI_API_KEY is set, else local "ollama".
DEFAULT_AI_PROVIDER=gemini

# ---- Gemini (cloud) ----
# NOTE: replace with a valid key from https://aistudio.google.com/apikey
# (the previously provided key was rejected by the API with "API key not valid")
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=15000
# Failover chain used when the primary model is rate-limited (free-tier quota is
# metered PER MODEL, so switching models keeps real AI answers flowing).
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash,gemini-flash-latest
# Identical prompts are cached for this long (ms) to save quota.
GEMINI_CACHE_TTL_MS=300000
AI_MODEL=gemini-3.5-flash-lite
# ---- Stability AI (text-to-image) ----
# Flat-rate image API (starter credit ~25 credits ~= 8 generations @ 3 credits each)
STABILITY_API_KEY=your-stability-api-key-here
STABILITY_IMAGE_ENDPOINT=https://api.stability.ai/v2beta/stable-image/generate/core


# ---- AI Provider (Ollama — local fallback / image synthesis) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_CHAT_MODEL=gemma4:e4b
OLLAMA_DEFAULT_CODE_MODEL=gemma4:e4b
OLLAMA_DEFAULT_IMAGE_MODEL=llava:7b
AI_REQUEST_TIMEOUT=180

# ---- Uploads ----
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=26214400
ALLOWED_EXTENSIONS=txt,md,pdf,docx,png,jpg,jpeg,gif,webp
